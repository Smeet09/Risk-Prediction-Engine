{
  "name": "Risk Prediction Engine Architecture",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "run-pipeline",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 250, 450 ],
      "webhookId": "run-pipeline-id-1234"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "interval": 6
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [ 250, 250 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4000/api/agents/run",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "regions",
              "value": "[]"
            }
          ]
        }
      },
      "name": "Start Run on Orchestrator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 450, 250 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/agents/weather/daily-sync",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"country\": \"India\",\n  \"job_id\": \"{{ $('Webhook Trigger').item?.body?.run_id || $('Start Run on Orchestrator').item?.json?.run_id || 'manual-run' }}\"\n}",
        "options": {
          "timeout": 3600000
        }
      },
      "name": "Data Ingestion Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 650, 350 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4000/api/agents/logs",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "run_id", "value": "={{ $('Webhook Trigger').item?.body?.run_id || $json.run_id }}" },
            { "name": "agent_name", "value": "data_ingestion" },
            { "name": "agent_label", "value": "Data Fetched" },
            { "name": "status", "value": "success" }
          ]
        }
      },
      "name": "Log Success (Data)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 850, 350 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/agents/gis/daily-run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"job_id\": \"{{ $('Webhook Trigger').item?.body?.run_id || $('Start Run on Orchestrator').item?.json?.run_id || 'manual-run' }}\"\n}",
        "options": {
          "timeout": 3600000
        }
      },
      "name": "GIS Processing Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 1050, 350 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4000/api/agents/logs"
      },
      "name": "Log Success (GIS)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 1250, 350 ]
    },
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [ 250, 750 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4000/api/agents/logs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"run_id\": \"LATEST\",\n  \"agent_name\": \"{{ $json.execution.lastNodeExecuted }}\",\n  \"agent_label\": \"System Crash\",\n  \"status\": \"failed\",\n  \"current_step\": \"Fatal N8N Crash\",\n  \"error\": \"{{ $json.execution.error.message }}\"\n}"
      },
      "name": "Log Failure (Global)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [ 450, 750 ]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [ [ { "node": "Log Failure (Global)", "type": "main", "index": 0 } ] ]
    },
    "Schedule Trigger": {
      "main": [ [ { "node": "Start Run on Orchestrator", "type": "main", "index": 0 } ] ]
    },
    "Start Run on Orchestrator": {
      "main": [ [ { "node": "Data Ingestion Agent", "type": "main", "index": 0 } ] ]
    },
    "Webhook Trigger": {
      "main": [ [ { "node": "Data Ingestion Agent", "type": "main", "index": 0 } ] ]
    },
    "Data Ingestion Agent": {
       "main": [ [ { "node": "Log Success (Data)", "type": "main", "index": 0 } ] ]
    },
    "Log Success (Data)": {
       "main": [ [ { "node": "GIS Processing Agent", "type": "main", "index": 0 } ] ]
    },
    "GIS Processing Agent": {
       "main": [ [ { "node": "Log Success (GIS)", "type": "main", "index": 0 } ] ]
    }
  },
  "settings": {}
}
