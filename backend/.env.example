# =============================================================
# Prediction Engine — Backend Environment Variables
# =============================================================

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prediction_engine

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Data storage root — portable, set to absolute path when moving project
# On Windows: DATA_ROOT=D:\my-data\prediction_engine
# On Linux/Mac: DATA_ROOT=/opt/prediction_engine/data
DATA_ROOT=../database

# FastAPI GIS Service
GIS_SERVICE_URL=http://localhost:8000

# Default admin credentials (change after first run!)
ADMIN_EMAIL=admin@bisag.predictionengine
ADMIN_PASSWORD=Admin@1234
